# Copy this file to .env for local/docker-compose runs.
# For Streamlit Community Cloud, put the same key under Settings -> Secrets instead.

# docker-compose default (matches docker-compose.yml's postgres service):
DATABASE_URL=postgresql://bdm:bdm@localhost:5432/bdm_tool

# Supabase example (Project Settings -> Database -> Connection string -> URI):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
